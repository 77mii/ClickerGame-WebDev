
{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "lib": ["dom", "esnext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "jsx": "react" // Enable JSX support
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "seed.ts","src/api/index.ts"],
}